<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gc.materials-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/admin/projects/curriculum_developer-deploy/scripts/materials/materials-check.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/admin/projects/curriculum_developer-deploy</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/admin</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Daily at 7:20 (StartCalendarInterval: StartInterval jobs stopped firing machine-wide 2026-10-07). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/admin/.local/state/gc-curriculum-tool/materials-check.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/admin/.local/state/gc-curriculum-tool/materials-check.stderr.log</string>
</dict>
</plist>
