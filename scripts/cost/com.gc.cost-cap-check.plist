<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gc.cost-cap-check</string>
  <!-- Hourly AI-spend alert (warn only; never blocks). Opens/closes a `cost-alert` GitHub issue. -->
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/node</string><string>/Users/admin/projects/curriculum_developer/scripts/cost/cost-cap-check.mjs</string></array>
  <key>WorkingDirectory</key><string>/Users/admin/projects/curriculum_developer</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string><key>HOME</key><string>/Users/admin</string></dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/admin/.local/state/gc-curriculum-tool/cost-cap.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/admin/.local/state/gc-curriculum-tool/cost-cap.stderr.log</string>
</dict>
</plist>
